# Music SP — configuration. Copy to .env (never committed) and fill in. No real secret belongs in this file.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin, exactly as typed in the browser. WebAuthn checks it byte for byte.
APP_URL=https://music.spboucher.ai
# WebAuthn RP ID. Defaults to the host of APP_URL (music.spboucher.ai): passkeys are then bound to this site only.
# Set to a registrable parent (spboucher.ai) only if passkeys must be shared with other sub-domains.
# Changing it later invalidates every enrolled passkey.
#WEBAUTHN_RP_ID=music.spboucher.ai
# 32+ random characters:  openssl rand -base64 48
APP_SECRET=
PORT=8690

# ── Owner (first administrator, created by scripts/bootstrap.ts) ─────────────
OWNER_EMAIL=
OWNER_NAME=
# Where the one-time enrolment link of the owner is written (mode 0600) while no passkey exists.
SETUP_URL_FILE=/Users/CHANGE_ME/data/sp-music/setup-url.txt

# ── Database (metadata only) ─────────────────────────────────────────────────
DATABASE_URL=postgres://spmusic_app:CHANGE_ME@127.0.0.1:5432/sp_music

# ── Private library storage ──────────────────────────────────────────────────
# local = a directory on the node's volume. (An S3-compatible driver would implement src/server/storage.ts.)
STORAGE_DRIVER=local
# Mount point of the library. Must NOT be inside the application directory or any web root.
STORAGE_ROOT=/Users/CHANGE_ME/data/sp-music/library
# Scratch space for uploads in progress (default: $STORAGE_ROOT/.tmp, same volume → atomic moves).
#TMP_DIR=

# ── Upload limits ────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_MB=2048
# Size of one request body; keep it at or below the reverse proxy's body limit.
UPLOAD_MAX_CHUNK_MB=16
# Files in progress at the same time (and audio files per archive).
UPLOAD_MAX_FILES=500
# Total library size allowed, in GB. 0 = no quota.
LIBRARY_QUOTA_GB=0
ARCHIVE_MAX_ENTRIES=2000
ARCHIVE_MAX_TOTAL_MB=20480
ARCHIVE_MAX_RATIO=100
# Retention: finished or failed import records (and abandoned upload data) are purged after this many days.
UPLOAD_RETENTION_DAYS=30

# ── Playback renditions ──────────────────────────────────────────────────────
# auto  = AAC rendition at import for formats some browsers cannot decode (ALAC, AIFF, Ogg), and on demand.
# never = originals only.
RENDITIONS=auto
RENDITION_BITRATE_KBPS=256
# DSD (DSF/DFF) originals are always kept. Set to true to also produce a playable AAC rendition.
TRANSCODE_DSD=false
#FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
#FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# ── Lyrics (optional, karaoke view) ──────────────────────────────────────────
# Speech-to-text runs on the node itself (mlx-whisper, Apple Silicon); no audio or text leaves the server.
# off = hidden · manual = an administrator asks for lyrics · auto = also queued for every new import
LYRICS=off
# Python of a virtualenv with mlx-whisper:  uv venv ~/.venvs/whisper --python 3.12 && uv pip install -p ~/.venvs/whisper mlx-whisper
#LYRICS_PYTHON=/Users/CHANGE_ME/.venvs/whisper/bin/python
#LYRICS_MODEL=mlx-community/whisper-large-v3-turbo

# ── Backups (scripts/backup.sh) ──────────────────────────────────────────────
BACKUP_DIR=/Users/CHANGE_ME/backups/sp-music
BACKUP_PASSPHRASE_FILE=/Users/CHANGE_ME/.config/sp-music/backup-passphrase
BACKUP_TRASH_DAYS=30
